      "item": [
        {
          "name": "Create Listing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "// Handle both wrapped (ApiResponse) and unwrapped responses",
                  "var listing = json.data || json;",
                  "",
                  "if (listing && listing.listing_id) {",
                  "    pm.collectionVariables.set('listing_id', listing.listing_id);",
                  "    console.log('listing_id saved:', listing.listing_id);",
                  "}",
                  "",
                  "pm.test('Has listing_id', function () {",
                  "    pm.expect(listing).to.have.property('listing_id');",
                  "});"
