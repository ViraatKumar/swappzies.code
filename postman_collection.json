          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Featured priority set', function () {",
                  "    var json = pm.response.json();",
                  "    var listing = json.data || json;",
                  "    pm.expect(listing.featured_priority).to.eql(1);",
                  "});"
                ]
